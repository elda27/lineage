{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",

    /* 層をまたぐ import は相対パスだと features/<機能>/ui から ../../../ が続いて読めなくなる。
       vite.config.ts の resolve.alias と同じ対応を持つ。 */
    "baseUrl": ".",
    "paths": {
      "@core/*": ["core/*"],
      "@/*": ["src/*"]
    },
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "core"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
