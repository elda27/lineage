{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lineage",
  "mainBinaryName": "fullos",
  "version": "0.0.8",
  "identifier": "com.lineage.fullos",
  "build": {
    "beforeDevCommand": "cargo build --manifest-path ../Cargo.toml -p agentos --locked && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && cargo build --release --manifest-path ../Cargo.toml -p minos -p agentos --locked",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "startup",
        "title": "fullos を起動中",
        "url": "startup.html",
        "width": 360,
        "height": 140,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false
      },
      {
        "label": "main",
        "title": "fullos",
        "width": 800,
        "height": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALDATA/minos/attachments/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../target/release/minos.exe": "minos.exe",
      "../../target/release/agentos.exe": "agentos.exe"
    },
    "windows": {
      "wix": {
        "version": "0.0.8.0",
        "template": "wix/main.wxs",
        "fragmentPaths": [
          "wix/minos.wxs"
        ],
        "componentGroupRefs": [
          "MinosShortcuts",
          "MinosAutoStart"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/elda27/lineage/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdCNjc2QTYwNTgxNzU5QkYKUldTL1dSZFlZR3BuZTFzZERROTNlOFRLQXdEN0xBV0VET0Y3aGRSd0xhOGF4c0NtSDJocGhPQlUK"
    }
  }
}
