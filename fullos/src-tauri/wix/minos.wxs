<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minos の Start Menu ショートカットとログオン時の自動起動。

  minos.exe 自体は tauri.conf.json の `bundle.resources` で INSTALLDIR 直下に
  入る（Tauri がコンポーネントを自動生成する）。そのコンポーネントの Id は
  ビルドごとに変わる GUID なので参照できず、ここではショートカットだけを持つ
  コンポーネントを別に用意して、Tauri のテンプレートが作る Start Menu フォルダ
  （ApplicationProgramsFolder）にぶら下げている。

  Tauri v2 の MSI は WiX v3 (candle/light) なのでスキーマは wix/2006/wi。
  tauri.conf.json の bundle.windows.wix.fragmentPaths / componentGroupRefs から参照。

  注意: このファイルは handlebars に「パースはされるが展開はされない」。
  二重波括弧の変数記法を書くと構文としては検証され、壊れているとビルドが落ちる。
  一方で main.wxs で使える manufacturer / product_name などの値はここでは
  解決されず、書いた文字列がそのまま MSI に入る（実際に literal な
  HKCU\Software\<二重波括弧の manufacturer> がレジストリに残った）。
  よってここでは値を直接書く。tauri.conf.json の productName / identifier を
  変えたらこのファイルも手で追随させること。
-->
<?if $(sys.BUILDARCH)="x86"?>
    <?define Win64 = "no" ?>
<?elseif $(sys.BUILDARCH)="x64"?>
    <?define Win64 = "yes" ?>
<?elseif $(sys.BUILDARCH)="arm64"?>
    <?define Win64 = "yes" ?>
<?else?>
    <?error Unsupported value of sys.BUILDARCH=$(sys.BUILDARCH)?>
<?endif?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Fragment>
        <ComponentGroup Id="MinosShortcuts" Directory="ApplicationProgramsFolder">
            <!--
              KeyPath がレジストリ値なので Guid="*"（File から導出）は使えず、固定 GUID を置く。
              アンインストール時の ApplicationProgramsFolder 削除は Tauri 側の
              ApplicationShortcut コンポーネントが持っているのでここでは触らない。

              Key は main.wxs 側（Software\<manufacturer>\<product_name>）に合わせた実値。
              manufacturer は tauri.conf.json の identifier "com.lineage.fullos" の
              2 番目の要素から Tauri が導出するので lineage、product_name も lineage。
              以前ここに変数記法を書いていたが展開されず literal なキーが残っていた
              （ファイル冒頭の注意を参照）。KeyPath を差し替えたので Guid も振り直してある。
            -->
            <Component Id="MinosStartMenuShortcut"
                       Guid="0B5AC74B-BD69-4EDD-ABE3-F6B045395D0D"
                       Win64="$(var.Win64)">
                <Shortcut Id="MinosStartMenuShortcut"
                          Name="Minos"
                          Description="Runs Minos"
                          Target="[INSTALLDIR]minos.exe"
                          WorkingDirectory="INSTALLDIR" />
                <RegistryValue Root="HKCU"
                               Key="Software\lineage\lineage"
                               Name="Minos Start Menu Shortcut"
                               Type="integer"
                               Value="1"
                               KeyPath="yes" />
            </Component>
        </ComponentGroup>
    </Fragment>

    <!--
      ログオン時、およびインストール直後に minos.exe を常駐させる。minos はトレイ常駐 +
      Alt+Space のアプリなので、起動していないと呼び出せない。

      Run 値は HKLM に置く。この MSI は main.wxs で InstallScope="perMachine" なので
      レジストリの書き込みは昇格した deferred アクション（= SYSTEM）が行い、HKCU は
      インストールしたユーザのハイブに落ちる保証がない。HKLM\...\Run ならこのマシンに
      ログオンする全ユーザで確実に起動する。perUser インストールに変えるなら HKCU へ移すこと。

      多重起動は minos 側の名前付き Mutex で抑止されるので、ショートカットから
      追加で起動されても増殖しない（minos/src/infrastructure/system/single_instance.rs）。
      値はアンインストール時にコンポーネントごと消える。

      autostart 引数（ExeCommand と Run 値に付けているもの）は「利用者が呼んだのではない」
      という印で、minos はこのとき入力画面を出さずトレイに入るだけになる
      （minos/src/main.rs）。付けないと、ログオンのたびに、また
      インストーラの最終画面の上に入力画面が現れる。
      なお XML のコメント内にはハイフン 2 個を書けないので、ここでは引数名を裸で書いている。
    -->
    <Fragment>
        <ComponentGroup Id="MinosAutoStart" Directory="INSTALLDIR">
            <!-- KeyPath がレジストリ値なので Guid="*" は使えず、固定 GUID を置く。 -->
            <Component Id="MinosRunAtLogon"
                       Guid="549A13DE-29FE-4CD8-9427-D9BE78878C50"
                       Win64="$(var.Win64)">
                <RegistryValue Root="HKLM"
                               Key="Software\Microsoft\Windows\CurrentVersion\Run"
                               Name="lineage Minos"
                               Type="string"
                               Value="&quot;[INSTALLDIR]minos.exe&quot; --autostart"
                               KeyPath="yes" />
            </Component>
        </ComponentGroup>

        <!--
          インストールが終わった時点で minos を起動する。Run 値だけだと次のログオンまで
          常駐せず、入れた直後に Alt+Space を押しても何も起きない。

          InstallExecuteSequence に置くので、UI 付きでも更新時のサイレント実行でも走る
          （Tauri の LaunchApplication は ExitDialog のチェックボックス経由なので UI 限定）。
          即時実行 + Impersonate なので、昇格した SYSTEM ではなくインストールを始めた
          利用者のセッションで起動する。asyncNoWait なのでインストーラは終了を待たない。

          条件の NOT Installed は「新規インストール」と「更新（メジャーアップグレードの
          新パッケージ側）」で真、アンインストールと修復では偽になる。更新のときは
          RemoveExistingProducts が古い minos を落としているので、ここで入れ直す形になる。
        -->
        <CustomAction Id="LaunchMinos"
                      Directory="INSTALLDIR"
                      ExeCommand="&quot;[INSTALLDIR]minos.exe&quot; --autostart"
                      Impersonate="yes"
                      Return="asyncNoWait" />
        <InstallExecuteSequence>
            <Custom Action="LaunchMinos" After="InstallFinalize">NOT Installed</Custom>
        </InstallExecuteSequence>
    </Fragment>
</Wix>
