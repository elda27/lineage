<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v5 installer definition for Minos.

  Build (from the repo root or the minos/ directory):

    cargo build --release
    wix build minos/wix/minos.wxs -b minos/target/release -o minos/target/wix/minos.msi

  -b (bindpath) tells WiX where to find minos.exe referenced below.
  Version is overridable at build time with:  -d Version=1.2.3
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?define Version = "0.1.0" ?>

  <Package
      Name="Minos"
      Manufacturer="Minos"
      Version="$(var.Version)"
      UpgradeCode="442C5203-65EC-43FB-B71F-D07464C76700"
      Language="1033"
      Codepage="1252"
      Scope="perMachine">

    <SummaryInformation Description="Minos" Manufacturer="Minos" />

    <!-- Block downgrades and replace older versions in place. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of Minos is already installed." />

    <!-- Embed a single cab inside the MSI so the .msi is self-contained. -->
    <MediaTemplate EmbedCab="yes" />

    <!-- Install layout: %ProgramFiles%\Minos and a Start Menu folder. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Minos" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppShortcutFolder" Name="Minos" />
    </StandardDirectory>

    <Feature Id="Main" Title="Minos" Level="1">
      <ComponentGroupRef Id="MinosComponents" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="MinosComponents" Directory="INSTALLFOLDER">
      <Component Id="MinosExe" Guid="*" Bitness="always64">
        <!-- Resolved via the bindpath (-b) passed to `wix build`. -->
        <File Id="MinosExe" Source="minos.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut"
                    Directory="AppShortcutFolder"
                    Name="Minos"
                    WorkingDirectory="INSTALLFOLDER"
                    Advertise="yes" />
        </File>
      </Component>

      <!-- Owns the Start Menu folder so it is removed on uninstall. -->
      <Component Id="StartMenuFolder" Directory="AppShortcutFolder" Guid="*">
        <RemoveFolder Id="RemoveAppShortcutFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\Minos"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
